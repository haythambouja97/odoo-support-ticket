<odoo>
    <template id="portal_my_home_ticket" name="Portal My Home : tickets"
              inherit_id="portal.portal_my_home" customize_show="True" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">Support Tickets</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="text">Follow your support tickets</t>
                <t t-set="placeholder_count" t-value="'ticket_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_breadcrumbs_ticket" name="Portal Breadcrumbs: tickets"
              inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'ticket'" class="breadcrumb-item">
                <a t-if="ticket" href="/my/tickets">Support Tickets</a>
                <t t-else="">Support Tickets</t>
            </li>
            <li t-if="ticket" class="breadcrumb-item active">
                <span t-field="ticket.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_tickets" name="My Support Tickets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Support Tickets</t>
            </t>
            <a href="/my/tickets/new" class="btn btn-primary mb-3">New Ticket</a>

            <t t-if="not tickets">
                <p>There are currently no tickets for your account.</p>
            </t>

            <t t-if="tickets">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Title</th>
                            <th>Priority</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="tickets" t-as="ticket">
                            <td>
                                <a t-attf-href="/my/tickets/#{ticket.id}">
                                    <span t-field="ticket.name"/>
                                </a>
                            </td>
                            <td><span t-field="ticket.title"/></td>
                            <td><span t-field="ticket.priority"/></td>
                            <td><span t-field="ticket.state"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
        <template id="portal_ticket_detail" name="Ticket Detail">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-12">
                    <a href="/my/tickets" class="btn btn-sm btn-secondary mb-3">
                        <i class="oi oi-arrow-left me-1" role="img" aria-label="Back"/>
                        Back to Tickets
                    </a>
                    <h3><span t-field="ticket.name"/> — <span t-field="ticket.title"/></h3>
                    <p><strong>Status:</strong> <span t-field="ticket.state"/></p>
                    <p><strong>Priority:</strong> <span t-field="ticket.priority"/></p>
                    <p t-field="ticket.description"/>
                </div>
            </div>
            <div class="mt-4">
                <t t-call="portal.message_thread">
                    <t t-set="object" t-value="ticket"/>
                    <t t-set="token" t-value="ticket.access_token"/>
                </t>
            </div>
        </t>
    </template>
        <template id="portal_ticket_new" name="New Ticket">
        <t t-call="portal.portal_layout">
            <h3>Submit a new ticket</h3>
            <form action="/my/tickets/new" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input type="text" name="title" class="form-control" required="required"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="5"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Priority</label>
                    <select name="priority" class="form-select">
                        <option value="0">Low</option>
                        <option value="1" selected="selected">Medium</option>
                        <option value="2">High</option>
                        <option value="3">Urgent</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </t>
    </template>
</odoo>