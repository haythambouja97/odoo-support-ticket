<odoo>
    <record id="action_support_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">support.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_support_ticket_list" model="ir.ui.view">
        <field name="name">support.ticket.list</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets">
                <field name="name"/>
                <field name="title"/>
                <field name="customer_id"/>
                <field name="assigned_user_id"/>
                <field name="priority"/>
                <field name="state"/>
            </list>
        </field>
    </record>
        <record id="view_support_ticket_form" model="ir.ui.view">
        <field name="name">support.ticket.form</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="customer_id"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

  <menuitem id="menu_support_ticket_root" 
  name="Support" 
  sequence="10"/>

  <menuitem id="menu_support_ticket" name="Tickets"
  parent="menu_support_ticket_root"
  action="action_support_ticket"
  sequence="10"/>
</odoo>

