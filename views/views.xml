<odoo>
    <record id="action_support_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">support.ticket</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_support_ticket_list" model="ir.ui.view">
        <field name="name">support.ticket.list</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets">
                <field name="name"/>
                <field name="title"/>
                <field name="customer_id"/>
                <field name="assigned_user_id"/>
                <field name="priority"/>
                <field name="state"/>
            </list>
        </field>
    </record>
        <record id="view_support_ticket_form" model="ir.ui.view">
        <field name="name">support.ticket.form</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="customer_id"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

        <record id="view_support_ticket_search" model="ir.ui.view">
        <field name="name">support.ticket.search</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name"/>
                <field name="title"/>
                <field name="customer_id"/>
                <field name="assigned_user_id"/>

                <filter name="filter_new" string="New"
                        domain="[('state', '=', 'new')]"/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <separator/>
                <filter name="filter_my_tickets" string="My Tickets"
                        domain="[('assigned_user_id', '=', uid)]"/>

                 <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_priority" string="Priority"
                        context="{'group_by': 'priority'}"/>
                <filter name="group_customer" string="Customer"
                        context="{'group_by': 'customer_id'}"/>
            </search>
        </field>
    </record>
        <record id="view_support_ticket_kanban" model="ir.ui.view">
        <field name="name">support.ticket.kanban</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong>
                            <div><field name="title"/></div>
                            <div class="text-muted"><field name="customer_id"/></div>
                            <div>
                                <field name="priority" widget="priority"/>
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

  <menuitem id="menu_support_ticket_root" 
  name="Support" 
  sequence="10"/>

  <menuitem id="menu_support_ticket" name="Tickets"
  parent="menu_support_ticket_root"
  action="action_support_ticket"
  sequence="10"/>
</odoo>

